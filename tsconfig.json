{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@components/*": ["src/components/*"],
      "@layouts/*": ["src/layouts/*"],
      "@i18n/*": ["src/i18n/*"],
      "@assets/*": ["src/assets/*"]
    },
    "jsx": "preserve",
    "verbatimModuleSyntax": true,
    "allowJs": true,
    "checkJs": false
  },
  "include": ["src", "src/env.d.ts", ".astro/types.d.ts"],
  "exclude": ["dist", "node_modules", ".astro"]
}
