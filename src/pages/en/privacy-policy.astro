---
/**
 * /en/privacy-policy/
 *
 * Renders the canonical Privacy Policy markdown.
 * Source of truth: src/content/legal/en/privacy-policy.md
 */
import BaseLayout from '@layouts/BaseLayout.astro';
import Header from '@components/Header.astro';
import Footer from '@components/Footer.astro';
import { getDictionary } from '@i18n/utils';
import { Content, frontmatter } from '../../content/legal/en/privacy-policy.md';

const locale = 'en' as const;
const dict = getDictionary(locale);

const title = `${frontmatter.title} — Privacy Score`;
const description = "Privacy Policy for the Privacy Score iOS app: local-only processing on your iPhone, no server, no account, no analytics SDK. GDPR-compliant.";
---

<BaseLayout locale={locale} title={title} description={description}>
  <Header locale={locale} pathname={Astro.url.pathname} nav={dict.nav} />
  <main class="legal-page">
    <article class="legal-content">
      <Content />
    </article>
  </main>
  <Footer footer={dict.footer} locale={locale} />
</BaseLayout>
