---
/**
 * /en/blog/[slug]/ - Blog post template (EN).
 *
 * Renders one BlogPost from src/content/blog/en/<slug>.md and emits
 * BlogPosting + BreadcrumbList JSON-LD per post. Mirrors the FR template
 * for layout / metadata structure.
 */
import BaseLayout from '@layouts/BaseLayout.astro';
import Header from '@components/Header.astro';
import Footer from '@components/Footer.astro';
import { getDictionary } from '@i18n/utils';
import { breadcrumbListJsonLd, blogPostingJsonLd } from '@i18n/jsonld';
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';

export async function getStaticPaths() {
  const all: CollectionEntry<'blog'>[] = await getCollection('blog');
  const posts = all.filter((p) => p.data.language === 'en');
  return posts.map((post) => ({
    params: { slug: post.data.slug },
    props: { post },
  }));
}

type Props = { post: CollectionEntry<'blog'> };

const { post } = Astro.props as Props;
const locale = 'en' as const;
const dict = getDictionary(locale);
const { Content } = await render(post);

const title = `${post.data.title} | Privacy Score`;
const description = post.data.description;
const canonicalUrl = `https://www.privacyscore.fr/en/blog/${post.data.slug}/`;

const dateFormatter = new Intl.DateTimeFormat('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const breadcrumb = breadcrumbListJsonLd([
  { name: 'Home', url: 'https://www.privacyscore.fr/en/' },
  { name: 'Blog', url: 'https://www.privacyscore.fr/en/blog/' },
  { name: post.data.title, url: canonicalUrl },
]);

const article = blogPostingJsonLd({
  locale,
  url: canonicalUrl,
  title: post.data.title,
  description,
  publishedAt: new Date(post.data.publishedAt),
  updatedAt: post.data.updatedAt ? new Date(post.data.updatedAt) : undefined,
  authorName: post.data.author,
  authorUrl: 'https://www.privacyscore.fr/en/about/',
  keywords: post.data.tags,
});
---

<BaseLayout
  locale={locale}
  title={title}
  description={description}
  jsonLd={[breadcrumb, article]}
>
  <Header locale={locale} pathname={Astro.url.pathname} nav={dict.nav} />
  <main class="legal-page">
    <article class="legal-content blog-post">
      <p class="blog-post-meta">
        <a href="/en/blog/">Blog</a>
        &nbsp;&middot;&nbsp;
        <time datetime={new Date(post.data.publishedAt).toISOString()}>
          {dateFormatter.format(new Date(post.data.publishedAt))}
        </time>
        {post.data.author ? <> &middot; {post.data.author}</> : null}
      </p>
      <h1>{post.data.title}</h1>
      <p class="blog-post-lede">{post.data.description}</p>
      <Content />
      <footer class="blog-post-footer">
        <p>
          <a href="/en/blog/" class="blog-back-link">&larr; All posts</a>
        </p>
      </footer>
    </article>
  </main>
  <Footer footer={dict.footer} locale={locale} />
</BaseLayout>

<style>
  .blog-post-meta {
    color: var(--text-tertiary, #64748B);
    font-size: 13px;
    margin: 0 0 1rem;
  }
  .blog-post-meta a {
    color: #60A5FA;
    text-decoration: none;
  }
  .blog-post-lede {
    font-size: 18px;
    line-height: 1.55;
    color: var(--text-secondary, #94A3B8);
    margin-bottom: 2rem;
  }
  .blog-post-footer {
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }
  .blog-back-link {
    color: #60A5FA;
    text-decoration: none;
    font-weight: 600;
  }
  .blog-back-link:hover {
    text-decoration: underline;
  }
</style>
