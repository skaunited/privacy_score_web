---
/**
 * /en/terms-of-use/
 *
 * Renders the canonical Terms of Use markdown.
 * Source of truth: src/content/legal/en/terms-of-use.md
 */
import BaseLayout from '@layouts/BaseLayout.astro';
import Header from '@components/Header.astro';
import Footer from '@components/Footer.astro';
import { getDictionary } from '@i18n/utils';
import { Content, frontmatter } from '../../content/legal/en/terms-of-use.md';

const locale = 'en' as const;
const dict = getDictionary(locale);

const title = `${frontmatter.title} — Privacy Score`;
const description = "Terms of Use for the Privacy Score iOS app: annual or six-month subscription, first scan free for life, cancellation via App Store, CM2C consumer mediator.";
---

<BaseLayout locale={locale} title={title} description={description}>
  <Header locale={locale} pathname={Astro.url.pathname} nav={dict.nav} />
  <main class="legal-page">
    <article class="legal-content">
      <Content />
    </article>
  </main>
  <Footer footer={dict.footer} locale={locale} />
</BaseLayout>
