---
/**
 * 404.astro - bilingual not-found page.
 *
 * Uses BaseLayout with locale='fr' as the default surface; renders FR + EN side by side.
 * Overrides the head with a `noindex,nofollow` robots tag (crawlers must neither
 * index this page nor follow its links) and a self-referential canonical so the
 * SEO component does not emit a hreflang pair pointing to nonexistent
 * `/fr/404/` and `/en/404/` URLs.
 */
import BaseLayout from '@layouts/BaseLayout.astro';

const locale = 'fr' as const;
---

<BaseLayout
  locale={locale}
  title="Page introuvable / Page not found | Privacy Score"
  description="Cette page n'existe pas sur privacyscore.fr. This page does not exist on privacyscore.fr."
>
  <Fragment slot="head">
    <meta name="robots" content="noindex,nofollow" />
    <link rel="canonical" href="https://www.privacyscore.fr/404/" />
  </Fragment>

  <main style="min-height: 70vh; display: grid; place-items: center; text-align: center; padding: 64px 24px;">
    <div>
      <h1 style="font-family: var(--font-display); font-size: clamp(48px, 8vw, 96px); margin: 0 0 12px;">404</h1>
      <p style="color: #94A3B8; margin: 0 0 32px;">
        Cette page n'existe pas. · This page does not exist.
      </p>
      <p style="display: inline-flex; gap: 12px; flex-wrap: wrap; justify-content: center;">
        <a class="btn btn-primary" href="/fr/">Retour à l'accueil</a>
        <a class="btn btn-ghost" href="/en/">Go to homepage</a>
      </p>
    </div>
  </main>
</BaseLayout>
