---
/**
 * /fr/politique-de-confidentialite/
 *
 * Renders the canonical Politique de confidentialite markdown.
 * Source of truth: src/content/legal/fr/politique-de-confidentialite.md
 *
 * Slug history: previously served at /fr/privacy-policy/. Restored to its
 * native French slug on 2026-06-01 with a 301 redirect from the old URL.
 */
import BaseLayout from '@layouts/BaseLayout.astro';
import Header from '@components/Header.astro';
import Footer from '@components/Footer.astro';
import { getDictionary } from '@i18n/utils';
import { breadcrumbListJsonLd } from '@i18n/jsonld';
import { Content } from '../../content/legal/fr/politique-de-confidentialite.md';

const locale = 'fr' as const;
const dict = getDictionary(locale);

const title = `Politique de confidentialité : Privacy Score, app iOS`;
const description = 'Traitement local des rapports dans l’application Privacy Score, et informations sur la mesure facultative du site web après consentement.';

const breadcrumb = breadcrumbListJsonLd([
  { name: 'Accueil', url: 'https://www.privacyscore.fr/fr/' },
  { name: 'Politique de confidentialité', url: 'https://www.privacyscore.fr/fr/politique-de-confidentialite/' },
]);
---

<BaseLayout locale={locale} title={title} description={description} jsonLd={breadcrumb}>
  <Header locale={locale} pathname={Astro.url.pathname} nav={dict.nav} />
  <main id="main-content" class="legal-page">
    <article class="legal-content">
      <Content />
    </article>
  </main>
  <Footer footer={dict.footer} locale={locale} />
</BaseLayout>
