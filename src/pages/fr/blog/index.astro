---
/**
 * /fr/blog/ - Blog index (FR).
 *
 * Lists every FR blog post sorted by publishedAt descending. Each card emits
 * minimal info (title + description + date + tags); the post detail page
 * carries the full BlogPosting JSON-LD.
 *
 * BreadcrumbList covers just the path Home -> Blog. Individual posts add
 * a third crumb when rendered.
 */
import BaseLayout from '@layouts/BaseLayout.astro';
import Header from '@components/Header.astro';
import Footer from '@components/Footer.astro';
import { getDictionary } from '@i18n/utils';
import { breadcrumbListJsonLd } from '@i18n/jsonld';
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';

const locale = 'fr' as const;
const dict = getDictionary(locale);

// Fetch all blog entries, filter to FR after, then sort newest-first.
// Filtering after avoids a TS inference quirk where getCollection's predicate
// callback narrows the return type to `never[]` when the schema field union
// can't be resolved at the filter site.
const allPosts: CollectionEntry<'blog'>[] = await getCollection('blog');
const posts = allPosts
  .filter((p) => p.data.language === 'fr')
  .sort(
    (a, b) =>
      new Date(b.data.publishedAt).getTime() -
      new Date(a.data.publishedAt).getTime(),
  );

const title = `Blog Privacy Score : confidentialité iPhone, audits, RGPD`;
const description = "Guides détaillés sur la confidentialité iPhone, le Rapport de Confidentialité iOS, les permissions des apps et les meilleures pratiques RGPD.";

const breadcrumb = breadcrumbListJsonLd([
  { name: 'Accueil', url: 'https://www.privacyscore.fr/fr/' },
  { name: 'Blog', url: 'https://www.privacyscore.fr/fr/blog/' },
]);

const dateFormatter = new Intl.DateTimeFormat('fr-FR', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<BaseLayout
  locale={locale}
  title={title}
  description={description}
  jsonLd={breadcrumb}
>
  <Header locale={locale} pathname={Astro.url.pathname} nav={dict.nav} />
  <main class="legal-page">
    <article class="legal-content">
      <h1>Blog Privacy Score</h1>
      <p class="blog-intro">
        Guides natifs en français pour comprendre la confidentialité iPhone.
        Chaque article est écrit pour le lecteur, pas pour le crawler.
      </p>
      <ul class="blog-list">
        {posts.map((post) => (
          <li class="blog-card">
            <article>
              <h2>
                <a href={`/fr/blog/${post.data.slug}/`}>{post.data.title}</a>
              </h2>
              <p class="blog-meta">
                <time datetime={new Date(post.data.publishedAt).toISOString()}>
                  {dateFormatter.format(new Date(post.data.publishedAt))}
                </time>
                {post.data.author ? <> &middot; {post.data.author}</> : null}
              </p>
              <p>{post.data.description}</p>
              {post.data.tags?.length ? (
                <p class="blog-tags">
                  {post.data.tags.map((t: string) => <span class="blog-tag">{t}</span>)}
                </p>
              ) : null}
            </article>
          </li>
        ))}
      </ul>
    </article>
  </main>
  <Footer footer={dict.footer} locale={locale} />
</BaseLayout>

<style>
  .blog-intro {
    color: var(--text-secondary, #94A3B8);
    font-size: 16px;
    margin-bottom: 2rem;
  }
  .blog-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
  }
  .blog-card {
    padding: 1.5rem 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }
  .blog-card:last-child {
    border-bottom: none;
  }
  .blog-card h2 {
    margin: 0 0 0.5rem;
    font-size: 22px;
    line-height: 1.3;
  }
  .blog-card h2 a {
    color: inherit;
    text-decoration: none;
  }
  .blog-card h2 a:hover {
    color: #60A5FA;
    text-decoration: underline;
  }
  .blog-meta {
    color: var(--text-tertiary, #64748B);
    font-size: 13px;
    margin: 0 0 0.75rem;
  }
  .blog-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 0.75rem;
  }
  .blog-tag {
    display: inline-block;
    padding: 2px 10px;
    border-radius: 9999px;
    background: rgba(96, 165, 250, 0.10);
    color: #60A5FA;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.02em;
  }
</style>
