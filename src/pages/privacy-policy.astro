---
/**
 * /en/privacy-policy/
 *
 * Renders the canonical Privacy Policy markdown.
 * Source of truth: src/content/legal/en/privacy-policy.md
 */
import BaseLayout from '@layouts/BaseLayout.astro';
import Header from '@components/Header.astro';
import Footer from '@components/Footer.astro';
import { getDictionary } from '@i18n/utils';
import { breadcrumbListJsonLd } from '@i18n/jsonld';
import { Content } from '../content/legal/en/privacy-policy.md';

const locale = 'en' as const;
const dict = getDictionary(locale);

const title = `Privacy Policy : Privacy Score, App Privacy Report`;
const description = 'How Privacy Score handles app reports locally, and how optional website audience measurement works after your permission.';

const breadcrumb = breadcrumbListJsonLd([
  { name: 'Home', url: 'https://www.privacyscore.fr/' },
  { name: 'Privacy Policy', url: 'https://www.privacyscore.fr/privacy-policy/' },
]);
---

<BaseLayout locale={locale} title={title} description={description} jsonLd={breadcrumb}>
  <Header locale={locale} pathname={Astro.url.pathname} nav={dict.nav} />
  <main id="main-content" class="legal-page">
    <article class="legal-content">
      <Content />
    </article>
  </main>
  <Footer footer={dict.footer} locale={locale} />
</BaseLayout>
