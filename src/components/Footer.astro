---
/**
 * Footer.astro - site footer.
 *
 * Matches `variation-illustrated.html` lines 1454-1491. Three columns of links,
 * brand block on the left, tagline + copyright + version row at the bottom.
 */
import type { Locale } from '@i18n/utils';

interface FooterLink {
  label: string;
  href: string;
}

interface FooterColumn {
  heading: string;
  links: FooterLink[];
}

interface Props {
  footer: {
    tagline: string;
    columns: {
      app: FooterColumn;
      legal: FooterColumn;
      resources?: FooterColumn;
      contact: FooterColumn;
    };
    copyright: string;
    version: string;
  };
  locale: Locale;
}

const { footer, locale } = Astro.props;
const cols: FooterColumn[] = [
  footer.columns.app,
  footer.columns.legal,
  ...(footer.columns.resources ? [footer.columns.resources] : []),
  footer.columns.contact,
];
---

<footer class="site-footer" role="contentinfo">
  <div class="footer-inner">
    <div>
      <div class="foot-brand">
        <img
          src="/assets/app-icon-96.webp"
          alt=""
          width="256"
          height="256"
          loading="lazy"
          decoding="async"
        />
        <strong style="color:#F8FAFC; font-family: var(--font-display); font-weight: 700;">Privacy Score</strong>
      </div>
      <p class="foot-sub" style="max-width: 320px; margin-top: 14px;">
        {footer.tagline}
      </p>
    </div>
    <div class="foot-cols">
      {cols.map((col) => (
        <nav aria-label={col.heading}>
          <div class="foot-h">{col.heading}</div>
          {col.links.map((link) => (
            <a href={link.href}>{link.label}</a>
          ))}
        </nav>
      ))}
    </div>
  </div>
  <button class="privacy-settings" type="button" data-privacy-settings hidden>{locale === 'fr' ? 'Préférences de mesure d’audience' : 'Audience measurement preferences'}</button>
  <div class="footer-rule"></div>
  <div class="container footer-foot">
    {/* `set:html` is needed because the copyright string contains an inline
        anchor link to the publisher's site (codevelop.fr). The content is
        trusted (controlled by the i18n dictionary, not user input), so the
        XSS surface is null. */}
    <span set:html={footer.copyright}></span>
    <span>{footer.version}</span>
  </div>
</footer>
