---
/**
 * CTASection.astro - final "Download" call to action.
 * Matches `variation-illustrated.html` lines 1426-1448.
 *
 * Pre-launch: the App Store URL does not yet exist, so the primary CTA renders
 * as a semantically disabled `<button>` with `aria-disabled="true"`. The label
 * surfaced via `cta.primary` already says "Bientôt disponible" / "Coming soon"
 * so the disabled state is also communicated as plain text for screen readers
 * and search-engine crawlers.
 *
 * When the App Store URL is confirmed, swap this `<button disabled>` back to
 * `<a href={appStoreUrl}>` and revert the `cta.primary` string.
 */
interface Props {
  cta: {
    title: string;
    body: string;
    primary: string;
    note: string; // HTML-safe
  };
}

const { cta } = Astro.props;
---

<section id="download" class="cta" aria-labelledby="cta-h2">
  <div class="orb orb-f"></div>
  <div class="container cta-inner">
    <div class="cta-copy reveal">
      <h2 id="cta-h2">{cta.title}</h2>
      <p>{cta.body}</p>
      <div class="cta-buttons">
        <button type="button" class="btn btn-primary btn-big" aria-disabled="true" disabled>
          <span class="material-icons-round" aria-hidden="true">schedule</span>
          {cta.primary}
        </button>
        <span class="cta-note" set:html={cta.note}></span>
      </div>
    </div>
    <div class="cta-mark">
      <img
        src="/assets/app-icon-512.webp"
        alt=""
        width="512"
        height="512"
        loading="eager"
        decoding="async"
      />
    </div>
  </div>
</section>
