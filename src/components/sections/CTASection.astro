---
/**
 * CTASection.astro - final "Download" call to action.
 * Matches `variation-illustrated.html` lines 1426-1448.
 *
 * The app shipped 2026-09 (Privacy Score: Tracker Audit, id6762229573), so the
 * primary CTA is a real `<a href={APP_STORE_URL[locale]}>` opening the App Store
 * in a new tab. (It previously rendered as a disabled "Coming soon" button.)
 */
import type { Locale } from '@i18n/utils';
import { APP_STORE_URL } from '@i18n/utils';

interface Props {
  cta: {
    title: string;
    body: string;
    primary: string;
    note: string; // HTML-safe
  };
  locale: Locale;
}

const { cta, locale } = Astro.props;
---

<section id="download" class="cta" aria-labelledby="cta-h2">
  <div class="orb orb-f"></div>
  <div class="container cta-inner">
    <div class="cta-copy reveal">
      <h2 id="cta-h2">{cta.title}</h2>
      <p>{cta.body}</p>
      <div class="cta-buttons">
        <a href={APP_STORE_URL[locale]} class="btn btn-primary btn-big" target="_blank" rel="noopener">
          <span class="material-icons-round" aria-hidden="true">download</span>
          {cta.primary}
        </a>
        <span class="cta-note" set:html={cta.note}></span>
      </div>
    </div>
    <div class="cta-mark">
      <img
        src="/assets/app-icon-512.webp"
        alt=""
        width="512"
        height="512"
        loading="eager"
        decoding="async"
      />
    </div>
  </div>
</section>
