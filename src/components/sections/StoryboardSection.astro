          <g transform="translate(50,40)">
            <rect x="0" y="0" width="100" height="68" rx="6" fill="#1E293B" stroke="rgba(96,165,250,0.30)" stroke-width="1"/>
            <rect x="5" y="5" width="90" height="58" rx="3" fill="#020617"/>
            <!-- terminal lines -->
            <g font-family="ui-monospace, monospace" fill="#60A5FA">
              <text x="11" y="18" font-size="6" opacity="0.5">$ buy --dataset gps</text>
              <text x="11" y="28" font-size="6" opacity="0.5">100M records ......</text>
              <text x="11" y="38" font-size="6" opacity="0.7">PRICE: $200</text>
              <text x="11" y="50" font-size="7" font-weight="700" fill="#FB7185">▶ CHECKOUT</text>
            </g>
            <!-- base -->
            <rect x="-12" y="68" width="124" height="6" rx="2" fill="#0B1730" stroke="rgba(255,255,255,0.05)"/>
            <rect x="42" y="68" width="16" height="3" fill="#020617"/>
          </g>
          <!-- coin -->
          <g transform="translate(36,90)">
            <circle cx="0" cy="0" r="14" fill="#0F1A33" stroke="#60A5FA" stroke-width="1.5"/>
            <text x="0" y="4" text-anchor="middle" font-family="ui-monospace, monospace" font-size="12" font-weight="700" fill="#60A5FA">$</text>
          </g>
          <!-- coffee cup -->
          <g transform="translate(168,108)">
            <rect x="0" y="0" width="18" height="20" rx="2" fill="#1E293B" stroke="rgba(255,255,255,0.10)"/>
            <ellipse cx="9" cy="0" rx="9" ry="2" fill="#60A5FA" opacity="0.35"/>
            <path d="M 18 5 Q 24 5 24 11 Q 24 17 18 17" stroke="rgba(255,255,255,0.10)" fill="none" stroke-width="1"/>
          </g>
        </svg>
      </div>
      <div class="caption">
        <strong>{story.panels[1].captionStrong}</strong>
        {story.panels[1].caption}
      </div>
    </article>

    <!-- ── PANEL 03 - 26 dots map ─────────────────────────────── -->
    <article class="sb-panel reveal" role="listitem">
      <div class="num">03/08</div>
      <div class="scene">
        <span class={`sb-tag ${tagLayout[2].position}`}>{story.panels[2].tag}</span>
        <svg class="scene-svg" viewBox="0 0 200 184" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <defs>
            <radialGradient id="ill3-bg" cx="50%" cy="50%">
