            </filter>
          </defs>
          <rect width="200" height="184" fill="url(#ill3-bg)"/>
          <rect width="200" height="184" fill="url(#ill3-grid)"/>
          <!-- subtle latitude curves -->
          <g stroke="rgba(96,165,250,0.20)" stroke-width="0.6" fill="none">
            <path d="M 0 50 Q 60 60 120 45 T 200 70"/>
            <path d="M 0 100 Q 70 95 130 110 T 200 95"/>
            <path d="M 0 140 Q 60 130 130 145 T 200 135"/>
          </g>
          <!-- 26 dots, glowing red -->
          <g fill="#FB7185" filter="url(#redGlow)">
            <circle cx="40" cy="40" r="3"/><circle cx="58" cy="55" r="3"/>
            <circle cx="74" cy="46" r="3"/><circle cx="92" cy="62" r="3"/>
            <circle cx="110" cy="48" r="3"/><circle cx="128" cy="66" r="3"/>
            <circle cx="146" cy="54" r="3"/><circle cx="166" cy="68" r="3"/>
            <circle cx="34" cy="90" r="3"/><circle cx="52" cy="100" r="3"/>
            <circle cx="72" cy="92" r="3"/><circle cx="94" cy="106" r="3"/>
            <circle cx="116" cy="96" r="3"/><circle cx="138" cy="108" r="3"/>
            <circle cx="158" cy="98" r="3"/><circle cx="178" cy="112" r="3"/>
            <circle cx="42" cy="140" r="3"/><circle cx="62" cy="150" r="3"/>
            <circle cx="84" cy="138" r="3"/><circle cx="104" cy="156" r="3"/>
            <circle cx="124" cy="142" r="3"/><circle cx="144" cy="158" r="3"/>
            <circle cx="166" cy="146" r="3"/><circle cx="184" cy="158" r="3"/>
            <circle cx="76" cy="170" r="3"/><circle cx="120" cy="172" r="3"/>
          </g>
          <!-- label -->
          <text x="100" y="22" text-anchor="middle" font-family="ui-monospace, monospace"
                font-size="8" font-weight="600" letter-spacing="2" fill="#94A3B8">WASHINGTON · DC</text>
        </svg>
      </div>
      <div class="caption">
        <strong>{story.panels[2].captionStrong}</strong>
        {story.panels[2].caption}
      </div>
    </article>

    <!-- ── PANEL 04 - Dossier identifiés ──────────────────────── -->
    <article class="sb-panel reveal" role="listitem">
      <div class="num">04/08</div>
      <div class="scene">
        <span class={`sb-tag ${tagLayout[3].position}${tagLayout[3].alert ? ' alert' : ''}`}>{story.panels[3].tag}</span>
        <svg class="scene-svg" viewBox="0 0 200 184" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <rect width="200" height="184" fill="#0A1428"/>
          <!-- file -->
          <g transform="translate(28,16) rotate(-2 80 76)">
            <rect x="0" y="0" width="160" height="152" rx="6" fill="#0F1A33" stroke="rgba(96,165,250,0.30)" stroke-width="1"/>
            <line x1="0" y1="22" x2="160" y2="22" stroke="rgba(96,165,250,0.30)"/>
            <text x="10" y="16" font-family="ui-monospace, monospace" font-size="8" font-weight="700" fill="#60A5FA" letter-spacing="1.5">DOSSIER · 2024-26</text>
            <!-- redaction bars -->
            <g fill="#1E293B">
              <rect x="10" y="30" width="74" height="6" rx="1"/>
              <rect x="92" y="30" width="58" height="6" rx="1"/>
              <rect x="10" y="42" width="100" height="6" rx="1"/>
              <rect x="116" y="42" width="32" height="6" rx="1"/>
              <rect x="10" y="54" width="60" height="6" rx="1"/>
              <rect x="76" y="54" width="74" height="6" rx="1"/>
              <rect x="10" y="66" width="120" height="6" rx="1"/>
              <rect x="10" y="78" width="80" height="6" rx="1"/>
              <rect x="98" y="78" width="52" height="6" rx="1"/>
              <rect x="10" y="90" width="100" height="6" rx="1"/>
              <rect x="10" y="102" width="60" height="6" rx="1"/>
              <rect x="78" y="102" width="50" height="6" rx="1"/>
            </g>
            <!-- 26 small avatar dots, like an identified list -->
            <g transform="translate(10,118)">
              <g fill="#60A5FA" opacity="0.9">
                <circle cx="4" cy="6" r="3"/><circle cx="14" cy="6" r="3"/><circle cx="24" cy="6" r="3"/>
                <circle cx="34" cy="6" r="3"/><circle cx="44" cy="6" r="3"/><circle cx="54" cy="6" r="3"/>
                <circle cx="64" cy="6" r="3"/><circle cx="74" cy="6" r="3"/><circle cx="84" cy="6" r="3"/>
                <circle cx="94" cy="6" r="3"/><circle cx="104" cy="6" r="3"/><circle cx="114" cy="6" r="3"/>
                <circle cx="124" cy="6" r="3"/>
                <circle cx="4" cy="18" r="3"/><circle cx="14" cy="18" r="3"/><circle cx="24" cy="18" r="3"/>
                <circle cx="34" cy="18" r="3"/><circle cx="44" cy="18" r="3"/><circle cx="54" cy="18" r="3"/>
                <circle cx="64" cy="18" r="3"/><circle cx="74" cy="18" r="3"/><circle cx="84" cy="18" r="3"/>
                <circle cx="94" cy="18" r="3"/><circle cx="104" cy="18" r="3"/><circle cx="114" cy="18" r="3"/>
                <circle cx="124" cy="18" r="3"/>
              </g>
            </g>
            <!-- stamp -->
            <g transform="translate(108,138) rotate(-12)">
              <rect x="-26" y="-9" width="52" height="20" fill="none" stroke="#FB7185" stroke-width="1.5" rx="2"/>
              <text x="0" y="4" text-anchor="middle" font-family="ui-monospace, monospace" font-size="8" font-weight="700" fill="#FB7185" letter-spacing="1.5">IDENTIFIÉS</text>
            </g>
          </g>
        </svg>
      </div>
      <div class="caption">
        <strong>{story.panels[3].captionStrong}</strong>
        {story.panels[3].caption}
      </div>
    </article>

    <!-- ── PANEL 05 - Strava 2018 ─────────────────────────────── -->
    <article class="sb-panel reveal" role="listitem">
      <div class="num">05/08</div>
      <div class="scene">
        <span class={`sb-tag ${tagLayout[4].position}`}>{story.panels[4].tag}</span>
        <svg class="scene-svg" viewBox="0 0 200 184" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <defs>
            <linearGradient id="ill5-sky" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0%" stop-color="#1A1845"/>
              <stop offset="60%" stop-color="#3B2A4D"/>
              <stop offset="100%" stop-color="#0A1428"/>
            </linearGradient>
            <filter id="trailGlow" x="-50%" y="-50%" width="200%" height="200%">
