              <rect x="6" y="6" width="6" height="6"/>
              <rect x="18" y="6" width="6" height="6"/>
              <rect x="30" y="6" width="6" height="6"/>
              <rect x="42" y="6" width="6" height="6"/>
            </g>
            <rect x="-6" y="32" width="68" height="4" fill="#0B1730"/>
            <line x1="28" y1="0" x2="28" y2="-14" stroke="#94A3B8" stroke-width="1"/>
            <circle cx="28" cy="-15" r="2" fill="#FB7185"/>
          </g>
          <!-- glowing red route -->
          <g filter="url(#trailGlow)">
            <path d="M 20 156 Q 60 144 100 150 T 180 138" stroke="#FB7185" stroke-width="2" fill="none" stroke-linecap="round"/>
          </g>
          <g fill="#FB7185" filter="url(#trailGlow)">
            <circle cx="20" cy="156" r="2.5"/>
            <circle cx="60" cy="146" r="2.5"/>
            <circle cx="100" cy="150" r="2.5"/>
            <circle cx="140" cy="142" r="2.5"/>
            <circle cx="180" cy="138" r="2.5"/>
          </g>
        </svg>
      </div>
      <div class="caption">
        <strong>{story.panels[4].captionStrong}</strong>
        {story.panels[4].caption}
      </div>
    </article>

    <!-- ── PANEL 06 - Your iPhone ─────────────────────────────── -->
    <article class="sb-panel reveal" role="listitem">
      <div class="num">06/08</div>
      <div class="scene">
        <span class={`sb-tag ${tagLayout[5].position}${tagLayout[5].alert ? ' alert' : ''}`}>{story.panels[5].tag}</span>
        <svg class="scene-svg" viewBox="0 0 200 184" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <defs>
            <radialGradient id="ill6-bg" cx="50%" cy="50%">
              <stop offset="0%" stop-color="#162447"/>
              <stop offset="100%" stop-color="#040814"/>
            </radialGradient>
            <filter id="leakGlow" x="-50%" y="-50%" width="200%" height="200%">
              <feGaussianBlur stdDeviation="1.5" result="b"/>
              <feMerge><feMergeNode in="b"/><feMergeNode in="SourceGraphic"/></feMerge>
            </filter>
          </defs>
          <rect width="200" height="184" fill="url(#ill6-bg)"/>
          <!-- phone -->
          <g transform="translate(72,18)">
            <rect x="0" y="0" width="56" height="148" rx="10" fill="#0F172A" stroke="rgba(96,165,250,0.30)" stroke-width="1"/>
            <rect x="3" y="6" width="50" height="136" rx="6" fill="#020617"/>
            <!-- notch -->
            <rect x="20" y="3" width="16" height="2" rx="1" fill="#0B1730"/>
            <!-- 9 app icons -->
            <g>
              <rect x="8" y="12" width="11" height="11" rx="2.5" fill="#60A5FA"/>
              <rect x="22" y="12" width="11" height="11" rx="2.5" fill="#FB7185"/>
              <rect x="36" y="12" width="11" height="11" rx="2.5" fill="#10B981"/>
              <rect x="8" y="26" width="11" height="11" rx="2.5" fill="#FBBF24"/>
              <rect x="22" y="26" width="11" height="11" rx="2.5" fill="#818CF8"/>
              <rect x="36" y="26" width="11" height="11" rx="2.5" fill="#60A5FA"/>
              <rect x="8" y="40" width="11" height="11" rx="2.5" fill="#FB7185"/>
              <rect x="22" y="40" width="11" height="11" rx="2.5" fill="#10B981"/>
              <rect x="36" y="40" width="11" height="11" rx="2.5" fill="#FBBF24"/>
            </g>
            <!-- progress fake -->
            <rect x="8" y="58" width="40" height="2" rx="1" fill="rgba(96,165,250,0.20)"/>
            <rect x="8" y="58" width="26" height="2" rx="1" fill="#60A5FA"/>
          </g>
          <!-- leak lines & labels -->
          <g stroke="#FB7185" stroke-width="1.5" fill="none" stroke-dasharray="3 3" filter="url(#leakGlow)">
            <path d="M 72 60 Q 40 50 26 30"/>
            <path d="M 128 60 Q 160 50 174 30"/>
            <path d="M 72 110 Q 40 110 22 130"/>
            <path d="M 128 110 Q 160 110 176 130"/>
          </g>
          <g font-family="ui-monospace, monospace" font-size="7" font-weight="700" fill="#FB7185">
            <text x="16" y="22" text-anchor="middle">→ PUB</text>
            <text x="180" y="22" text-anchor="middle">→ GPS</text>
            <text x="16" y="146" text-anchor="middle">→ ID</text>
            <text x="180" y="146" text-anchor="middle">→ AGE</text>
          </g>
        </svg>
      </div>
      <div class="caption">
        <strong>{story.panels[5].captionStrong}</strong>
        {story.panels[5].caption}
      </div>
    </article>

    <!-- ── PANEL 07 - Privacy Score appears ───────────────────── -->
    <article class="sb-panel reveal" role="listitem">
      <div class="num">07/08</div>
      <div class="scene">
        <span class={`sb-tag ${tagLayout[6].position}`}>{story.panels[6].tag}</span>
        <svg class="scene-svg" viewBox="0 0 200 184" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <defs>
            <radialGradient id="ill7-burst" cx="50%" cy="50%">
              <stop offset="0%" stop-color="#60A5FA" stop-opacity="0.65"/>
              <stop offset="50%" stop-color="#3B82F6" stop-opacity="0.25"/>
              <stop offset="100%" stop-color="#0A1428" stop-opacity="0"/>
            </radialGradient>
            <linearGradient id="ill7-ring" x1="0" y1="0" x2="1" y2="1">
              <stop offset="0%" stop-color="#60A5FA"/>
              <stop offset="100%" stop-color="#3B82F6"/>
            </linearGradient>
            <filter id="ringGlow" x="-50%" y="-50%" width="200%" height="200%">
              <feGaussianBlur stdDeviation="3" result="b"/>
              <feMerge><feMergeNode in="b"/><feMergeNode in="SourceGraphic"/></feMerge>
