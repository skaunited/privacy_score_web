            <pattern id="ill3-grid" x="0" y="0" width="18" height="18" patternUnits="userSpaceOnUse">
              <circle cx="9" cy="9" r="0.8" fill="#60A5FA" opacity="0.18"/>
            </pattern>
            <filter id="redGlow" x="-100%" y="-100%" width="300%" height="300%">
              <feGaussianBlur stdDeviation="2" result="b"/>
