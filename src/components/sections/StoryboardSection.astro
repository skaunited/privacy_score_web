<style>
  /* ============================================================
     STORYBOARD - scoped styles (design lines 70-210)
     Chapter etiquette (.chapter, .ch-pill, .ch-label) lives in
     `site.css` since 5 sections share it.
  ============================================================ */
  .story-board {
    position: relative;
    padding: 140px 32px 120px;
    background: linear-gradient(180deg, #020617 0%, #050B21 100%);
    overflow: hidden;
  }
  /* Radial-gradient glow instead of filter:blur (iOS scroll-repaint cost). */
  .story-board :global(.orb) {
    position: absolute; border-radius: 50%;
    pointer-events: none; z-index: 0;
  }
  .story-board :global(.orb-1) { width: 660px; height: 660px; background: radial-gradient(circle, rgba(99,102,241,0.16) 0%, rgba(99,102,241,0) 70%); top: 40px; right: -200px; }
  .story-board :global(.orb-2) { width: 600px; height: 600px; background: radial-gradient(circle, rgba(59,130,246,0.16) 0%, rgba(59,130,246,0) 70%); bottom: 60px; left: -200px; }

  .sb-head { max-width: 880px; margin: 0 auto 70px; text-align: center; position: relative; z-index: 2; }
  .sb-head :global(.overline) { color: #60A5FA; font-size: 11px; font-weight: 700; letter-spacing: 0.22em; text-transform: uppercase; }
  .sb-head h2 {
    font-family: var(--font-display); font-weight: 800;
    font-size: clamp(28px, 3.6vw, 48px);
    line-height: 1.15; letter-spacing: -0.02em;
    color: #F8FAFC; margin: 18px 0;
    text-wrap: pretty;
  }
  .sb-head h2 .hi {
    color: #FB7185;
    position: relative; display: inline-block;
    padding: 0 6px;
  }
  .sb-head h2 .hi::after {
    content: ""; position: absolute; inset: 0;
    background: rgba(251,113,133,0.10);
    border-radius: 6px; z-index: -1;
  }
  .sb-head p {
    font-size: 18px; line-height: 1.55; color: #94A3B8;
    max-width: 620px; margin: 0 auto;
  }

  /* 8-panel grid */
  .sb-strip {
    max-width: 1200px; margin: 0 auto;
    display: grid; grid-template-columns: repeat(4, 1fr);
    gap: 18px;
    position: relative; z-index: 2;
  }
  .sb-panel {
    /* Opaque background, no backdrop-filter: 8 of these scroll through the
       viewport; per-panel blur re-sampling is the iOS checkerboard cause. */
    background: rgba(17, 25, 45, 0.92);
    border: 1px solid rgba(255,255,255,0.06);
    border-radius: 20px;
    overflow: hidden;
    position: relative;
    transition: transform .35s var(--ease-out), border-color .3s, box-shadow .3s;
  }
  .sb-panel:hover {
    transform: translateY(-4px);
    border-color: rgba(96,165,250,0.30);
    box-shadow: 0 20px 50px -10px rgba(96,165,250,0.18);
  }
  .sb-panel .num {
    display: flex; align-items: center;
    padding: 14px 18px 8px;
    font-family: var(--font-mono, ui-monospace, SF Mono, Menlo, monospace);
    font-size: 11px; font-weight: 600;
    color: #60A5FA; letter-spacing: 0.16em;
  }
  .sb-panel .num::before {
    content: ""; display: inline-block; width: 18px; height: 1px;
    background: rgba(96,165,250,0.5); vertical-align: middle; margin-right: 8px;
  }
  .sb-panel .scene {
    display: block; width: 100%;
    aspect-ratio: 1 / 0.92;
    background: linear-gradient(180deg, #0E1A33 0%, #0A1428 100%);
    position: relative;
    overflow: hidden;
    border-bottom: 1px solid rgba(255,255,255,0.04);
  }
  .sb-panel .scene svg.scene-svg { display: block; width: 100%; height: 100%; }

  /* Floating label inside scene (replaces speech bubble) */
  .sb-tag {
    position: absolute; z-index: 4;
    background: rgba(15, 23, 42, 0.92);
    border: 1px solid rgba(96,165,250,0.30);
    color: #60A5FA;
    border-radius: 9999px;
    padding: 5px 12px;
    font-family: var(--font-display);
    font-size: 10.5px; font-weight: 700;
    letter-spacing: 0.10em; text-transform: uppercase;
    white-space: nowrap;
    box-shadow: 0 6px 20px rgba(0,0,0,0.4);
  }
  .sb-tag.tl { top: 12px; left: 12px; }
  .sb-tag.tr { top: 12px; right: 12px; }
  .sb-tag.bl { bottom: 12px; left: 12px; }
  .sb-tag.br { bottom: 12px; right: 12px; }
  .sb-tag.alert { border-color: rgba(251,113,133,0.40); color: #FB7185; }

  /* Caption */
  .sb-panel .caption {
    padding: 18px 18px 22px;
    font-family: var(--font-body);
    font-size: 13.5px;
    line-height: 1.55;
    color: #94A3B8;
  }
  .sb-panel .caption strong {
    color: #F8FAFC; font-weight: 700;
    display: block; margin-bottom: 4px;
    font-family: var(--font-display);
    font-size: 14.5px; letter-spacing: -0.01em;
  }

  /* Strip responsive */
  @media (max-width: 1100px) { .sb-strip { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 540px) { .sb-strip { grid-template-columns: 1fr; } }

  /* Pivot */
  .sb-pivot {
    margin: 100px auto 0;
    text-align: center;
    position: relative; z-index: 2;
  }
  .sb-pivot .line {
    width: 1px; height: 60px; margin: 0 auto 24px;
    background: linear-gradient(180deg, transparent, #60A5FA, transparent);
  }
  .sb-pivot p {
    font-family: var(--font-display);
    font-size: clamp(22px, 2.4vw, 32px);
    line-height: 1.3; color: #F8FAFC;
    font-weight: 700; letter-spacing: -0.015em;
  }
  .sb-pivot p strong { color: #60A5FA; font-weight: 800; }
  .sb-pivot p em { color: #FB7185; font-style: normal; }
</style>
