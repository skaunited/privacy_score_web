---
/**
 * StoryboardSection.astro - Chapter 01/05 "L'histoire".
 *
 * 8 narrative panels with verbatim inline SVG illustrations copy-pasted
 * byte-for-byte from `variation-illustrated.html` (lines 620-1065).
 *
 * Tag pill positions (`tl/tr/bl/br`) and the `alert` (red) flag are
 * layout-only: they live in this component, never in the dict.
 *
 * Scoped CSS below contains the storyboard-specific rules from design
 * lines 70-210 (chapter etiquette is global, in `site.css`).
 */
interface Panel {
  tag: string;
  captionStrong: string;
  caption: string;
}

interface Props {
  story: {
    title: { pre: string; hi: string; post: string };
    intro: string;
    panels: Panel[];
    pivot: {
      line1Pre: string;
      line1Em: string;
      line1Post: string;
      line2Pre: string;
      line2Strong: string;
    };
  };
  chapters: {
    word: string;
    story: { label: string };
  };
}

const { story, chapters } = Astro.props;

// Tag pill layout - never i18n, see spec section 3.
type Pos = 'tl' | 'tr' | 'bl' | 'br';
const tagLayout: { position: Pos; alert?: boolean }[] = [
  { position: 'tr' },                  // 01 Washington
  { position: 'tr', alert: true },     // 02 Open market
  { position: 'tl' },                  // 03 26 red dots
  { position: 'br', alert: true },     // 04 Identifiés
  { position: 'tl' },                  // 05 Strava 2018
  { position: 'tr', alert: true },     // 06 Your iPhone
  { position: 'tl' },                  // 07 A tool appears
  { position: 'br' },                  // 08 +45 points
];
---

<section class="story-board" id="story" aria-labelledby="story-h2">
  <div class="orb orb-1"></div>
  <div class="orb orb-2"></div>

  <div class="sb-head reveal">
    <div class="chapter">
      <span class="ch-pill">{chapters.word} <span class="ch-current">01</span> <span class="ch-total">/ 05</span></span>
      <span class="ch-label">{chapters.story.label}</span>
    </div>
    <h2 id="story-h2">
      {story.title.pre}<span class="hi">{story.title.hi}</span>{story.title.post}
    </h2>
    <p>{story.intro}</p>
  </div>

  <div class="sb-strip" role="list">

    <!-- ── PANEL 01 - Washington 2024 ──────────────────────────── -->
    <article class="sb-panel reveal" role="listitem">
      <div class="num">01/08</div>
      <div class="scene">
        <span class={`sb-tag ${tagLayout[0].position}`}>{story.panels[0].tag}</span>
        <svg class="scene-svg" viewBox="0 0 200 184" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <defs>
            <linearGradient id="ill1-sky" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0%" stop-color="#162447"/>
              <stop offset="100%" stop-color="#0A1428"/>
            </linearGradient>
            <radialGradient id="ill1-moon" cx="50%" cy="50%">
              <stop offset="0%" stop-color="#60A5FA" stop-opacity="0.5"/>
              <stop offset="100%" stop-color="#60A5FA" stop-opacity="0"/>
            </radialGradient>
          </defs>
          <rect width="200" height="184" fill="url(#ill1-sky)"/>
          <!-- moon glow -->
          <circle cx="160" cy="40" r="40" fill="url(#ill1-moon)"/>
          <circle cx="160" cy="40" r="9" fill="#CBD5E1"/>
          <!-- stars -->
          <g fill="#CBD5E1" opacity="0.6">
            <circle cx="30" cy="22" r="0.8"/><circle cx="62" cy="36" r="0.8"/>
            <circle cx="98" cy="18" r="1.2"/><circle cx="120" cy="44" r="0.8"/>
            <circle cx="14" cy="50" r="0.8"/><circle cx="190" cy="78" r="0.8"/>
          </g>
          <!-- ground -->
          <rect x="0" y="135" width="200" height="49" fill="#0F1A33"/>
          <line x1="0" y1="135" x2="200" y2="135" stroke="rgba(96,165,250,0.15)" stroke-width="1"/>
          <!-- White House silhouette -->
          <g>
            <polygon points="60,80 140,80 100,62" fill="#1E293B" stroke="rgba(96,165,250,0.25)" stroke-width="1"/>
            <rect x="60" y="80" width="80" height="55" fill="#1E293B" stroke="rgba(96,165,250,0.25)" stroke-width="1"/>
            <!-- columns lit windows -->
            <g fill="#60A5FA" opacity="0.85">
              <rect x="68" y="98" width="6" height="20"/>
              <rect x="82" y="98" width="6" height="20"/>
              <rect x="96" y="98" width="6" height="20"/>
              <rect x="110" y="98" width="6" height="20"/>
              <rect x="124" y="98" width="6" height="20"/>
            </g>
            <!-- flag pole -->
            <line x1="100" y1="62" x2="100" y2="48" stroke="#CBD5E1" stroke-width="1"/>
            <rect x="100" y="48" width="10" height="6" fill="#FB7185"/>
          </g>
          <!-- 2 agent silhouettes -->
          <g fill="#0B1730" stroke="rgba(96,165,250,0.40)" stroke-width="1">
            <g transform="translate(20,108)">
              <circle cx="6" cy="0" r="5"/>
              <rect x="0" y="5" width="12" height="22"/>
            </g>
            <g transform="translate(170,108)">
              <circle cx="6" cy="0" r="5"/>
              <rect x="0" y="5" width="12" height="22"/>
            </g>
          </g>
          <!-- discreet earpiece dots glowing -->
          <circle cx="27" cy="106" r="1.5" fill="#FB7185"/>
          <circle cx="177" cy="106" r="1.5" fill="#FB7185"/>
        </svg>
      </div>
      <div class="caption">
        <strong>{story.panels[0].captionStrong}</strong>
        {story.panels[0].caption}
      </div>
    </article>

    <!-- ── PANEL 02 - Data market $200 ─────────────────────────── -->
    <article class="sb-panel reveal" role="listitem">
      <div class="num">02/08</div>
      <div class="scene">
        <span class={`sb-tag ${tagLayout[1].position}${tagLayout[1].alert ? ' alert' : ''}`}>{story.panels[1].tag}</span>
        <svg class="scene-svg" viewBox="0 0 200 184" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <defs>
            <radialGradient id="ill2-bg" cx="50%" cy="40%">
              <stop offset="0%" stop-color="#162447"/>
              <stop offset="100%" stop-color="#0A1428"/>
