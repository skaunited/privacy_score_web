---
/**
 * MetricsSection.astro - 4-up "Privacy Score by the numbers" band.
 * Matches `variation-illustrated.html` lines 1326-1347.
 * Numbers render at their final value in static HTML (no JS count-up).
 * Previously each value started at 0 and animated up via site.js, which
 * meant the band showed "0 / 0 / 0 / 0" until JS ran.
 */
interface Metric {
  countTo: number;
  label: string;
}

interface Props {
  metrics: {
    ariaLabel: string;
    items: Metric[];
  };
}

const { metrics } = Astro.props;
---

<section class="metrics" aria-label={metrics.ariaLabel}>
  <div class="container">
    <div class="metric-row reveal">
      {metrics.items.map((m) => (
        <div class="metric">
          <div class="metric-num" data-count-to={m.countTo}>{m.countTo}</div>
          <div class="metric-label">{m.label}</div>
        </div>
      ))}
    </div>
  </div>
</section>
