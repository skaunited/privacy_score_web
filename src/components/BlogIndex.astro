---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import { publishedPosts, postPath } from '../content/blog';
import { getDictionary, pathForPage, toAbsoluteUrl, type Locale } from '../i18n/utils';
import { breadcrumbListJsonLd } from '../i18n/jsonld';
const { locale } = Astro.props as { locale: Locale };
const fr = locale === 'fr';
const dict = getDictionary(locale);
const posts = await publishedPosts(locale);
const title = fr ? 'Guides confidentialité iPhone et rapport des apps' : 'iPhone Privacy Guides and App Privacy Report Help';
const description = fr ? 'Lire, importer et comprendre le rapport de confidentialité iPhone. Des guides sur les autorisations, les réglages et les rapports vides.' : 'Read, export and understand your iPhone App Privacy Report. Practical guides to permissions, privacy settings and empty or missing report data.';
const format = new Intl.DateTimeFormat(fr ? 'fr-FR' : 'en-US', { dateStyle:'long' });
const breadcrumb = breadcrumbListJsonLd([
  { name: fr ? 'Accueil' : 'Home', url: toAbsoluteUrl(pathForPage(locale, 'home')) },
  { name:'Blog', url:toAbsoluteUrl(pathForPage(locale, 'blog')) },
]);
---
<BaseLayout locale={locale} title={`${title} | Privacy Score`} description={description} jsonLd={breadcrumb}>
  <Header locale={locale} pathname={Astro.url.pathname} nav={dict.nav} />
  <main id="main-content" class="legal-page">
    <article class="legal-content">
      <h1>{title}</h1>
      <p class="blog-intro">{description}</p>
      <ul class="blog-list">
        {posts.map((post) => <li class="blog-card"><article>
          <h2><a href={postPath(post)}>{post.data.title}</a></h2>
          <p class="blog-meta">
            <time datetime={post.data.publishedAt.toISOString()}>{format.format(post.data.publishedAt)}</time>
            {post.data.author && <> · {post.data.author}</>}
            {post.data.updatedAt && <> · {fr ? 'Révisé le' : 'Reviewed'}{' '}<time datetime={post.data.updatedAt.toISOString()}>{format.format(post.data.updatedAt)}</time></>}
          </p>
          <p>{post.data.description}</p>
          {post.data.tags?.length ? <p class="blog-tags">{post.data.tags.map((tag: string) => <span class="blog-tag">{tag}</span>)}</p> : null}
        </article></li>)}
      </ul>
    </article>
  </main>
  <Footer footer={dict.footer} locale={locale} />
</BaseLayout>
<style>
  .blog-intro {
    color: var(--text-secondary, #94A3B8);
    font-size: 16px;
    margin-bottom: 2rem;
  }
  .blog-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
  }
  .blog-card {
    padding: 1.5rem 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }
  .blog-card:last-child {
    border-bottom: none;
  }
  .blog-card h2 {
    margin: 0 0 0.5rem;
    font-size: 22px;
    line-height: 1.3;
  }
  .blog-card h2 a {
    color: inherit;
    text-decoration: none;
  }
  .blog-card h2 a:hover {
    color: #60A5FA;
    text-decoration: underline;
  }
  .blog-meta {
    color: #697990;
    font-size: 13px;
    margin: 0 0 0.75rem;
  }
  .blog-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 0.75rem;
  }
  .blog-tag {
    display: inline-block;
    padding: 2px 10px;
    border-radius: 9999px;
    background: rgba(96, 165, 250, 0.10);
    color: #60A5FA;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.02em;
  }
</style>
