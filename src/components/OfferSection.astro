---
import { annualOfferText } from '../config/product';
import { APP_STORE_URL, type Locale } from '../i18n/utils';
const { locale } = Astro.props as { locale: Locale };
---
<aside class="offer-panel" aria-label={locale === 'fr' ? 'Offre de lancement' : 'Launch offer'}>
  <div>
    <p class="overline">{locale === 'fr' ? 'Offre de lancement · App Store France' : 'Launch offer · French App Store'}</p>
    <h2>{locale === 'fr' ? 'Votre premier audit est gratuit.' : 'Your first privacy audit is free.'}</h2>
    <p>{annualOfferText(locale)}</p>
    <p class="offer-detail">{locale === 'fr'
      ? 'Premium inclut les audits supplémentaires, les outils DNS/VPN et l’export. Abonnement à renouvellement automatique, résiliable dans les réglages Apple.'
      : 'Premium includes additional audits, DNS/VPN tools and report export. Subscriptions renew automatically and can be canceled in your Apple account settings.'}</p>
  </div>
  <a class="btn btn-primary" href={APP_STORE_URL[locale]} data-cta="launch-offer">{locale === 'fr' ? 'Voir l’offre sur l’App Store' : 'View the App Store offer'}</a>
</aside>
<style>
  .offer-panel { max-width:1136px; margin:0 auto 3rem; padding:2rem; border:1px solid #38557f; border-radius:24px; background:#0d1628; display:flex; gap:2rem; align-items:center; }
  h2 { margin:.5rem 0; font-size:clamp(1.4rem,3vw,2rem); }
  p { line-height:1.65; color:#cbd5e1; }
  .offer-detail { font-size:.875rem; }
  a { flex-shrink:0; }
  @media(max-width:800px) { .offer-panel { margin:0 20px 2rem; padding:1.5rem; flex-direction:column; align-items:flex-start; } }
</style>
