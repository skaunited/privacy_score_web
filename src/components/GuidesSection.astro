---
import { publishedPosts, postPath } from '../content/blog';
import { pathForPage, type Locale } from '../i18n/utils';
const { locale } = Astro.props as { locale: Locale };
const posts = (await publishedPosts(locale)).slice(0, 4);
---
<section class="guides-section container" id="guides" aria-labelledby="guides-title">
  <p class="overline">{locale === 'fr' ? 'Guides pratiques' : 'Practical guides'}</p>
  <h2 id="guides-title">{locale === 'fr' ? 'Une question, une prochaine étape.' : 'One question. A useful next step.'}</h2>
  <div class="guide-cards">
    {posts.map((post) => <article>
      <h3><a href={postPath(post)}>{post.data.title}</a></h3>
      <p>{post.data.description}</p>
      <a class="guide-link" href={postPath(post)}>{locale === 'fr' ? 'Lire le guide' : 'Read the guide'} →</a>
    </article>)}
  </div>
  <a class="guide-link" href={pathForPage(locale, 'blog')}>{locale === 'fr' ? 'Tous les articles' : 'All articles'} →</a>
</section>
<style>
  .guides-section { padding-top:5rem; padding-bottom:5rem; }
  h2 { font-size:clamp(1.8rem,4vw,2.6rem); }
  .guide-cards { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:1.25rem; margin:2rem 0; }
  article { background:#0d1628; border:1px solid #283c5a; border-radius:20px; padding:1.5rem; }
  h3 { margin-top:0; line-height:1.4; font-size:1.25rem; }
  p { color:#cbd5e1; line-height:1.7; }
  .guide-link { color:#93c5fd; text-decoration:underline; text-underline-offset:4px; }
  @media(max-width:650px) { .guide-cards { grid-template-columns:1fr; } }
</style>
