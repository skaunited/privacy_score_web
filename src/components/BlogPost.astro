---
import { render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import { getDictionary, pathForPage, toAbsoluteUrl, type Locale } from '../i18n/utils';
import { breadcrumbListJsonLd, blogPostingJsonLd } from '../i18n/jsonld';
import { publishedPosts, postPath, postAlternates } from '../content/blog';

const { post } = Astro.props as { post: CollectionEntry<'blog'> };
const locale: Locale = post.data.language;
const fr = locale === 'fr';
const dict = getDictionary(locale);
const rendered = await render(post);
const Content = rendered.Content;
const all = await publishedPosts();
const alternates = postAlternates(post, all);
const url = toAbsoluteUrl(postPath(post));
const format = new Intl.DateTimeFormat(fr ? 'fr-FR' : 'en-US', { dateStyle: 'long' });
const breadcrumb = breadcrumbListJsonLd([
  { name: fr ? 'Accueil' : 'Home', url: toAbsoluteUrl(pathForPage(locale, 'home')) },
  { name: 'Blog', url: toAbsoluteUrl(pathForPage(locale, 'blog')) },
  { name: post.data.title, url },
]);
const article = blogPostingJsonLd({
  locale, url, title: post.data.title, description: post.data.description,
  publishedAt: post.data.publishedAt, updatedAt: post.data.updatedAt,
  authorName: post.data.author, authorUrl: toAbsoluteUrl(pathForPage(locale, 'about')),
  keywords: post.data.tags,
  imageUrl: post.data.hero?.src ? toAbsoluteUrl(post.data.hero.src) : undefined,
});
---
<BaseLayout locale={locale} title={`${post.data.title} | Privacy Score`} description={post.data.description}
  jsonLd={[breadcrumb, article]} alternates={alternates} ogType="article" ogImage={post.data.hero?.src}>
  <Header locale={locale} pathname={Astro.url.pathname} nav={dict.nav} alternates={alternates.length ? alternates : undefined} />
  <main id="main-content" class="legal-page">
    <article class="legal-content">
      <p class="blog-post-meta">
        <time datetime={post.data.publishedAt.toISOString()}>{format.format(post.data.publishedAt)}</time>
        · <a href={pathForPage(locale, 'about')}>{post.data.author}</a>
        {post.data.updatedAt && <> · {fr ? 'Révisé le' : 'Reviewed'}{' '}<time datetime={post.data.updatedAt.toISOString()}>{format.format(post.data.updatedAt)}</time></>}
      </p>
      <h1>{post.data.title}</h1>
      <p class="blog-post-lede">{post.data.description}</p>
      <Content />
      <footer class="blog-post-footer">
        <p><a href={pathForPage(locale, 'blog')} class="blog-back-link">← {fr ? 'Tous les articles' : 'All posts'}</a></p>
      </footer>
    </article>
  </main>
  <Footer footer={dict.footer} locale={locale} />
</BaseLayout>
<style>
  .blog-post-meta {
    color: #697990;
    font-size: 13px;
    margin: 0 0 1rem;
  }
  .blog-post-meta a {
    color: #60A5FA;
    text-decoration: underline;
  }
  .blog-post-lede {
    font-size: 18px;
    line-height: 1.55;
    color: var(--text-secondary, #94A3B8);
    margin-bottom: 2rem;
  }
  .blog-post-footer {
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }
  .blog-back-link {
    color: #60A5FA;
    text-decoration: none;
    font-weight: 600;
  }
  .blog-back-link:hover {
    text-decoration: underline;
  }
</style>
