{
  "name": "privacy-score-web",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Privacy Score iOS marketing site \u2014 Astro 6 static output, English root and French /fr.",
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build",
    "preview": "astro preview --host",
    "astro": "astro",
    "redirects": "node scripts/generate-redirects.mjs",
    "check:seo": "python3 scripts/check-seo.py",
    "check:redirects": "node scripts/generate-redirects.mjs --check && node scripts/check-redirects.mjs",
    "test:browser": "playwright test",
    "check": "pnpm build && pnpm check:seo && pnpm check:redirects",
    "release": "bash scripts/package-release.sh"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.3",
    "@fontsource-variable/jetbrains-mono": "^5.2.8",
    "@fontsource-variable/manrope": "^5.2.8",
    "astro": "^6.4.3",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=10"
  },
  "packageManager": "pnpm@11.0.0",
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "sharp": "^0.34.5"
  }
}
